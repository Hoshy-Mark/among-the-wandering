extends "res://personagem/qa_characters106.gd"
func check(value: bool,message: String) -> void:
    if not value:push_error("MENU107_FAIL "+message);get_tree().quit(1);assert(value,message)
    checks.append(message);print("MENU107_CHECK ",message)
func shot(scene: Node,name: String) -> void:
    await frames(scene,8);await RenderingServer.frame_post_draw
    check(scene.get_viewport().get_texture().get_image().save_png("res://qa/menu107/"+name+".png")==OK,"capture "+name)
func run(scene: Node3D) -> void:
    DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path("res://qa/menu107"))
    var p=scene.player;var m=scene.get_node("Characters99");var ui=m.skills_ui;var quick=p.get_node("Atalhos93")
    h._freeze98(scene);h._player_idle(p);quick.scripted=false;p.condition_path="res://qa/menu107/checkpoint.json";scene.get_window().size=Vector2i(1280,720)
    if "--menu107-reopen" in OS.get_cmdline_user_args():
        check(p.load_condition(),"fresh process loads official checkpoint with exploration")
        var expected=JSON.parse_string(FileAccess.get_file_as_string("res://qa/menu107/expected.json"))
        expected.exploration=ui.exploration.validate(expected.exploration);expected.social=m.social.validate(expected.social);expected.preferences=ui.preferences.normalize(expected.preferences)
        check(ui.exploration.snapshot()==expected.exploration,"exploration and marks survive restart")
        check(m.social.snapshot()==expected.social,"skills facts and RNG survive restart")
        check(ui.preferences.applied==expected.preferences,"real preferences survive restart")
        check(m.registry.met==expected.met,"known actors survive restart")
        await key(scene,KEY_P);check(ui.opened,"menu works after restart")
        ui.exploration.position=Vector2(p.global_position.x,p.global_position.z);ui.map_center=Vector2.ZERO;ui.select_tab(2);await shot(scene,"10_mapa_reaberto")
        await key(scene,KEY_ESCAPE);check(not p.hud_open,"input unlocked after closing")
        var legacy=p.session_save.prepare(JSON.parse_string(FileAccess.get_file_as_string("res://qa/characters106/checkpoint.json")),false)
        check(not legacy.is_empty() and p.session_save.pending_map107.cells.is_empty(),"R106 campaign migrates with empty exploration without fabricated visits")
        finish();return
    ui.preferences.applied=ui.preferences.defaults.duplicate(true);ui.preferences.execute(ui.preferences.applied);ui.draft=ui.preferences.applied.duplicate(true)
    var inventory=p.bag_inventory.items.duplicate(true);var rounds=p.weapons.rounds.duplicate(true);var bindings=quick.bindings.duplicate(true)
    check(ui.exploration.places.size()>=40,"cartography sourced from instantiated city buildings")
    var unknown=m.registry.met.duplicate(true);var before=m.social.snapshot()
    await key(scene,KEY_P);check(ui.opened and p.hud_open,"P opens shared menu and locks gameplay")
    check(ui.buttons.size()==4 and ui.tabs.size()==4,"four skills and four bottom tabs")
    check(not ui.train("empathy"),"upgrade rejected without points")
    var action_before=quick.bindings.duplicate(true);await key(scene,KEY_3);check(ui.selected=="empathy" and quick.bindings==action_before,"number selects skill without weapon action")
    ui.select_tab(1);check(ui.projection.characters(m).is_empty(),"unknown NPCs absent from projection")
    check(m.social.snapshot()==before and m.registry.met==unknown,"menu reads never reveal facts")
    await key(scene,KEY_ESCAPE);check(not ui.opened and not p.hud_open,"escape releases input")
    # Use genuine saved progression from approved R106 QA, never inject HTML fixtures.
    check(m.social.restore(JSON.parse_string(FileAccess.get_file_as_string("res://qa/characters106/expected.json"))),"approved gameplay progression loads")
    var fixture=JSON.parse_string(FileAccess.get_file_as_string("res://qa/characters106/checkpoint.json"))
    check(m.registry.restore(fixture.characters99),"known NPCs from actual saved introductions")
    await key(scene,KEY_P);ui.select_tab(0);await shot(scene,"01_habilidades")
    var points=m.social.available_points();var rank=m.social.data.skills.empathy
    check(ui.train("empathy") and m.social.available_points()==points-1 and m.social.data.skills.empathy==rank+1,"upgrade spends one point through authoritative model")
    ui.select_tab(1);var rows=ui.projection.characters(m)
    check(rows.size()==6,"only six actually introduced actors appear")
    check(rows.all(func(row):return row.relationship.values().all(func(value):return value==null)),"hidden numeric relations remain unknown not zero")
    var renata=rows.filter(func(row):return row.id=="renata_volker")[0]
    check(not JSON.stringify(renata).contains("jornalista") and renata.biography.size()>=1,"progressive biography excludes hidden profession")
    check(rows.all(func(row):return row.life.contains("último encontro") and row.bond=="Conhecido"),"last known life independent of alliance classification")
    ui.selected_npc="renata_volker";ui.refresh();await shot(scene,"02_personagens")
    ui.exploration.update(Vector2(p.global_position.x,p.global_position.z));var known=ui.exploration.known()
    check(not known.is_empty(),"actual starting location discovered")
    check(not ui.exploration.mark("NOT_KNOWN"),"unknown marker rejected")
    ui.selected_place=known[0].id;check(ui.exploration.mark(known[0].id),"known place can be marked")
    check(not ui.exploration.validate(ui.exploration.snapshot()).is_empty(),"campaign exploration validates")
    var tampered=ui.exploration.snapshot();tampered.marked.append("NOT_KNOWN");check(ui.exploration.validate(tampered).is_empty(),"save validation rejects hidden marker")
    ui.select_tab(2);await shot(scene,"03_mapa")
    var old_zoom=ui.map_view.zoom;ui.map_view.set_zoom(old_zoom*1.2);check(ui.map_view.zoom>old_zoom,"map zoom changes scale")
    ui.map_view.center+=Vector2(10,0);ui.map_view.focus_player();check(ui.map_view.center==ui.exploration.position,"center button uses world player coordinates")
    var discovered=ui.exploration.snapshot();ui.map_filter=2;ui.refresh();check(ui.exploration.snapshot()==discovered,"filter does not discover world")
    ui.select_tab(3);ui.category=0;ui.refresh();await shot(scene,"04_video")
    ui.category=1;ui.refresh();await shot(scene,"05_audio")
    ui.draft.volume=63;check(ui.preferences.applied.volume!=63,"draft has no immediate runtime authority")
    ui.close();await frames(scene,2);check(ui.modal.visible and ui.opened,"dirty close asks to discard");ui.modal.hide()
    ui.apply_preferences();check(ui.preferences.applied.volume==63 and not ui.dirty() and absf(db_to_linear(AudioServer.get_bus_volume_db(0))-.63)<.001,"apply persists and changes actual Master volume")
    var reloaded=load("res://personagem/menu107/preferences.gd").new();reloaded.path=ui.preferences.path;reloaded.setup();check(reloaded.applied.volume==63,"preferences reload from disk")
    var conflict=ui.draft.duplicate(true);conflict.bindings.character_skills=[KEY_W];check(not ui.preferences.valid(conflict),"fixed movement key conflict rejected")
    conflict=ui.draft.duplicate(true);conflict.bindings.character_skills=[KEY_ESCAPE];check(not ui.preferences.valid(conflict),"escape cannot be rebound")
    ui.category=2;ui.refresh();await shot(scene,"06_controles")
    ui.capture="character_skills";await key(scene,KEY_ESCAPE);check(ui.capture=="" and ui.opened,"escape cancels key capture without closing")
    ui.capture="character_skills";await key(scene,KEY_F8);check(ui.draft.bindings.character_skills==[KEY_F8],"captured available key enters draft")
    ui.apply_preferences();check(ui._hint()=="F8","apply updates actual InputMap")
    await key(scene,KEY_ESCAPE);await key(scene,KEY_F8);check(ui.opened,"rebound key opens actual menu")
    ui.draft=ui.preferences.defaults.duplicate(true);ui.apply_preferences();check(ui._hint()=="P","defaults restore menu key")
    ui.draft.resolution=1;ui.apply_preferences();check(ui.video.visible and ui.video_seconds>0,"video change requires timed confirmation")
    ui._rollback_video();await frames(scene,4);check(ui.preferences.applied.resolution==0 and DisplayServer.window_get_size()==Vector2i(1280,720),"video rollback restores actual window")
    for index in [0,1,2,3]:
        scene.get_window().size=Vector2i(640,600);await frames(scene,6);ui.select_tab(index);await frames(scene,6)
        check(ui.panel.get_global_rect().end.x<=640 and ui.tabs[index].get_global_rect().end.y<=600,"small window navigation fits tab "+str(index))
        await shot(scene,"07_small_"+str(index))
    for index in [0,1,2,3]:
        scene.get_window().size=Vector2i(390,844);await frames(scene,6);ui.select_tab(index);await frames(scene,6)
        check(ui.panel.get_global_rect().end.x<=390 and ui.tabs[index].get_global_rect().end.y<=844,"narrow window navigation fits tab "+str(index))
        await shot(scene,"07_narrow_"+str(index))
    scene.get_window().size=Vector2i(1280,720);await frames(scene,8);ui.force_close()
    var spot=await approach106(scene,m,"samuel_henrique");check(spot!=null,"conversation reachable after menu")
    check(m.open("samuel_henrique"),"D02 opens after menu");await shot(scene,"08_dialogo")
    await key(scene,KEY_P);check(not ui.opened and m.active=="samuel_henrique","menu does not steal dialogue input");m.close()
    check(p.bag_inventory.items==inventory and p.weapons.rounds==rounds and quick.bindings==bindings,"inventory ammunition and equipped quickslots unchanged")
    check(scene.zombie_world.saved.size()==480,"fixed zombie population preserved")
    ui.exploration.update(Vector2(p.global_position.x,p.global_position.z));check(p.save_condition(),"official campaign save includes exploration")
    var expected={"exploration":ui.exploration.snapshot(),"social":m.social.snapshot(),"preferences":ui.preferences.applied,"met":m.registry.met.duplicate(true)}
    var f=FileAccess.open("res://qa/menu107/expected.json",FileAccess.WRITE);f.store_string(JSON.stringify(expected));f.close()
    check(p.load_condition(),"official campaign reload succeeds")
    check(ui.exploration.snapshot()==expected.exploration and m.social.snapshot()==expected.social,"campaign reload reproduces map and social state")
    await shot(scene,"09_gameplay");finish()
func finish() -> void:
    var f=FileAccess.open("res://qa/menu107/"+("fresh.json" if "--menu107-reopen" in OS.get_cmdline_user_args() else "results.json"),FileAccess.WRITE);f.store_string(JSON.stringify({"passed":true,"checks":checks},"  "));f.close();get_tree().quit()
