var failed104=false
func check(value: bool,message: String) -> void:
    if not value:failed104=true;push_error("R104_FAIL "+message);get_tree().quit(1);assert(value,message)
    checks.append(message);print("R104_CHECK ",message)
func capture104(scene: Node,name: String) -> void:
    await frames(scene,6);await RenderingServer.frame_post_draw
    check(scene.get_viewport().get_texture().get_image().save_png("res://qa/characters104/"+name+".png")==OK,"native capture "+name)
func stream104(model: RefCounted) -> String:
    for n in range(1,10000):
        var rng=RandomNumberGenerator.new();rng.seed=n;var before=str(rng.state)
        var pressure=model.resolve_roll(rng.randi_range(1,6),rng.randi_range(1,6),2,11)
        var listening=model.resolve_roll(rng.randi_range(1,6),rng.randi_range(1,6),3,9)
        if not pressure and listening:return before
    assert(false);return ""
