extends "res://personagem/qa_characters104.gd"
var failed105=false
func check(value: bool,message: String) -> void:
    if not value:failed105=true;push_error("R105_FAIL "+message);get_tree().quit(1);assert(value,message)
    checks.append(message);print("R105_CHECK ",message)
func capture105(scene: Node,name: String) -> void:
